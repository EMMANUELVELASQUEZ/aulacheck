# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Session (use a long random string in production) ──────────
SESSION_SECRET=change_this_to_a_long_random_secret_in_production

# ── Database ──────────────────────────────────────────────────
# Railway provides MYSQL_URL automatically. For local dev, use:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=aulacheck
DB_PORT=3306

# ── Optional: Railway MySQL (auto-set by Railway) ─────────────
# MYSQL_URL=mysql://user:pass@host:port/db
# MYSQLHOST=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQLPORT=
