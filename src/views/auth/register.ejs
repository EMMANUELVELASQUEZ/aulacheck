<%- include('../layouts/auth_top') %>

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
  <div class="w-100" style="max-width: 480px;">
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle mb-3" style="width:80px;height:80px;box-shadow:0 4px 20px rgba(0,0,0,0.3)">
        <i class="bi bi-display-fill" style="font-size:2rem;color:#006633;"></i>
      </div>
      <h1 class="text-white fw-bold mb-0">AulaCheck</h1>
      <p class="text-white-50">Universidad Veracruzana</p>
    </div>

    <% if (locals.success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-2"></i><%= success_msg[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (locals.error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <div class="card shadow-lg border-0 rounded-4">
      <div class="card-body p-4">
        <h4 class="card-title fw-bold mb-1">
          <%= typeof isFirstSetup !== 'undefined' && isFirstSetup ? 'Crear cuenta de administrador' : 'Crear cuenta' %>
        </h4>
        <p class="text-muted small mb-4">
          <%= typeof isFirstSetup !== 'undefined' && isFirstSetup ? 'Primera configuración del sistema' : 'Completa el formulario de registro' %>
        </p>

        <form action="/auth/register" method="POST" novalidate>
          <div class="mb-3">
            <label for="nombre" class="form-label fw-semibold">Nombre Completo</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person"></i></span>
              <input type="text" class="form-control" id="nombre" name="nombre"
                placeholder="Ej: Dr. Juan García" required autocomplete="name">
            </div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label fw-semibold">Correo Electrónico</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-envelope"></i></span>
              <input type="email" class="form-control" id="email" name="email"
                placeholder="correo@uv.mx" required autocomplete="email">
            </div>
          </div>

          <% if (typeof isAdminUser !== 'undefined' && isAdminUser) { %>
          <div class="mb-3">
            <label for="rol" class="form-label fw-semibold">Rol</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
              <select class="form-select" id="rol" name="rol">
                <option value="docente" selected>Docente</option>
                <option value="tecnico">Técnico</option>
                <option value="admin">Administrador</option>
              </select>
            </div>
          </div>
          <% } %>

          <div class="mb-3">
            <label for="password" class="form-label fw-semibold">Contraseña</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-lock"></i></span>
              <input type="password" class="form-control" id="password" name="password"
                placeholder="Mínimo 6 caracteres" required minlength="6">
            </div>
          </div>

          <div class="mb-3">
            <label for="confirmar_password" class="form-label fw-semibold">Confirmar Contraseña</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
              <input type="password" class="form-control" id="confirmar_password" name="confirmar_password"
                placeholder="Repite tu contraseña" required>
            </div>
          </div>

          <div class="d-grid mt-4">
            <button type="submit" class="btn btn-uv btn-lg fw-semibold">
              <i class="bi bi-person-plus me-2"></i>
              <%= typeof isFirstSetup !== 'undefined' && isFirstSetup ? 'Crear Cuenta Admin' : 'Registrarse' %>
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="text-center mt-3">
      <a href="/auth/login" class="text-white-50 small text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i>¿Ya tienes cuenta? Inicia sesión
      </a>
    </div>
  </div>
</div>

<%- include('../layouts/auth_bottom') %>
