<%- include('../layouts/main_top') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">
      <i class="bi bi-person-<%= user ? 'pencil' : 'plus' %> text-uv me-2"></i>
      <%= user ? 'Editar Usuario' : 'Nuevo Usuario' %>
    </h1>
    <p class="text-muted mb-0">
      <%= user ? `Modificar datos de ${user.nombre}` : 'Crear nuevo usuario en el sistema' %>
    </p>
  </div>
  <a href="/admin/usuarios" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Volver
  </a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold">Datos del Usuario</h5>
      </div>
      <div class="card-body p-4">
        <form action="<%= action %>?<%= method === 'PUT' ? '_method=PUT' : '' %>" method="POST" novalidate>
          <div class="mb-3">
            <label for="nombre" class="form-label fw-semibold">Nombre Completo <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person"></i></span>
              <input type="text" class="form-control" id="nombre" name="nombre"
                value="<%= user ? user.nombre : '' %>" required placeholder="Ej: Dr. Juan García">
            </div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label fw-semibold">Correo Electrónico <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-envelope"></i></span>
              <input type="email" class="form-control" id="email" name="email"
                value="<%= user ? user.email : '' %>" required placeholder="correo@uv.mx">
            </div>
          </div>

          <div class="mb-3">
            <label for="rol" class="form-label fw-semibold">Rol <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
              <select class="form-select" id="rol" name="rol" required>
                <option value="docente" <%= !user || user.rol === 'docente' ? 'selected' : '' %>>Docente</option>
                <option value="tecnico" <%= user && user.rol === 'tecnico' ? 'selected' : '' %>>Técnico</option>
                <option value="admin" <%= user && user.rol === 'admin' ? 'selected' : '' %>>Administrador</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label for="password" class="form-label fw-semibold">
              Contraseña <%= user ? '(dejar vacío para no cambiar)' : '<span class="text-danger">*</span>' %>
            </label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-lock"></i></span>
              <input type="password" class="form-control" id="password" name="password"
                <%= !user ? 'required' : '' %> minlength="6" placeholder="<%= user ? 'Dejar vacío para mantener' : 'Mínimo 6 caracteres' %>">
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="/admin/usuarios" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-uv px-4">
              <i class="bi bi-save me-2"></i><%= user ? 'Guardar Cambios' : 'Crear Usuario' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/main_bottom') %>
