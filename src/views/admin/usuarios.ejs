<%- include('../layouts/main_top') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1"><i class="bi bi-people text-uv me-2"></i>Usuarios</h1>
    <p class="text-muted mb-0"><%= users.length %> usuario(s) en el sistema</p>
  </div>
  <a href="/admin/usuarios/nuevo" class="btn btn-uv">
    <i class="bi bi-person-plus me-2"></i>Nuevo Usuario
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="width:50px">#</th>
            <th>Nombre</th>
            <th>Correo Electrónico</th>
            <th>Rol</th>
            <th>Estado</th>
            <th>Registrado</th>
            <th style="width:120px">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td class="ps-3 text-muted small"><%= u.id %></td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="user-avatar-sm" style="background: <%= u.rol === 'admin' ? '#dc3545' : u.rol === 'tecnico' ? '#ffc107' : '#0dcaf0' %>; color: white; width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:bold;">
                  <%= u.nombre.charAt(0).toUpperCase() %>
                </div>
                <div>
                  <div class="fw-semibold"><%= u.nombre %></div>
                  <% if (u.id === user.id) { %>
                    <small class="text-muted">(Tú)</small>
                  <% } %>
                </div>
              </div>
            </td>
            <td class="text-muted"><%= u.email %></td>
            <td>
              <% if (u.rol === 'admin') { %>
                <span class="badge bg-danger">Administrador</span>
              <% } else if (u.rol === 'tecnico') { %>
                <span class="badge bg-warning text-dark">Técnico</span>
              <% } else { %>
                <span class="badge bg-info text-dark">Docente</span>
              <% } %>
            </td>
            <td>
              <span class="badge <%= u.activo ? 'bg-success' : 'bg-secondary' %>">
                <i class="bi bi-<%= u.activo ? 'check-circle' : 'x-circle' %> me-1"></i>
                <%= u.activo ? 'Activo' : 'Inactivo' %>
              </span>
            </td>
            <td class="text-muted small">
              <%= new Date(u.created_at).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'}) %>
            </td>
            <td>
              <div class="d-flex gap-1">
                <a href="/admin/usuarios/<%= u.id %>/edit" class="btn btn-sm btn-outline-primary" title="Editar">
                  <i class="bi bi-pencil"></i>
                </a>
                <% if (u.id !== user.id) { %>
                <form action="/admin/usuarios/<%= u.id %>/toggle" method="POST" class="d-inline"
                  onsubmit="return confirm('<%= u.activo ? '¿Desactivar' : '¿Activar' %> a <%= u.nombre %>?')">
                  <button type="submit" class="btn btn-sm <%= u.activo ? 'btn-outline-warning' : 'btn-outline-success' %>"
                    title="<%= u.activo ? 'Desactivar' : 'Activar' %>">
                    <i class="bi bi-<%= u.activo ? 'pause-circle' : 'play-circle' %>"></i>
                  </button>
                </form>
                <% } %>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/main_bottom') %>
