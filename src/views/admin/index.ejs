<%- include('../layouts/main_top') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1"><i class="bi bi-shield-check text-uv me-2"></i>Panel de Administración</h1>
    <p class="text-muted mb-0">Gestión del sistema AulaCheck — Universidad Veracruzana</p>
  </div>
</div>

<!-- Stats -->
<div class="row g-4 mb-4">
  <div class="col-sm-6 col-xl-4">
    <div class="card stat-card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Usuarios Activos</p>
            <h2 class="fw-bold mb-0"><%= stats.total_users %></h2>
          </div>
          <div class="stat-icon bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-people"></i>
          </div>
        </div>
        <div class="mt-2">
          <a href="/admin/usuarios" class="text-decoration-none text-muted small">Gestionar usuarios <i class="bi bi-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-4">
    <div class="card stat-card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Aulas Activas</p>
            <h2 class="fw-bold mb-0"><%= stats.total_aulas %></h2>
          </div>
          <div class="stat-icon bg-success bg-opacity-10 text-success">
            <i class="bi bi-building"></i>
          </div>
        </div>
        <div class="mt-2">
          <a href="/admin/aulas" class="text-decoration-none text-muted small">Gestionar aulas <i class="bi bi-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-4">
    <div class="card stat-card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Total Equipos</p>
            <h2 class="fw-bold mb-0"><%= stats.total_equipos %></h2>
          </div>
          <div class="stat-icon bg-info bg-opacity-10 text-info">
            <i class="bi bi-cpu"></i>
          </div>
        </div>
        <div class="mt-2">
          <span class="text-muted small">Registrados en el sistema</span>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-4">
    <div class="card stat-card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Incidencias Pendientes</p>
            <h2 class="fw-bold mb-0 <%= stats.incidencias_pendientes > 0 ? 'text-danger' : 'text-success' %>">
              <%= stats.incidencias_pendientes %>
            </h2>
          </div>
          <div class="stat-icon bg-danger bg-opacity-10 text-danger">
            <i class="bi bi-exclamation-triangle"></i>
          </div>
        </div>
        <div class="mt-2">
          <a href="/incidencias?estado=pendiente" class="text-decoration-none text-muted small">Ver pendientes <i class="bi bi-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-4">
    <div class="card stat-card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Equipos en Falla</p>
            <h2 class="fw-bold mb-0 <%= stats.equipos_en_falla > 0 ? 'text-warning' : 'text-success' %>">
              <%= stats.equipos_en_falla %>
            </h2>
          </div>
          <div class="stat-icon bg-warning bg-opacity-10 text-warning">
            <i class="bi bi-tools"></i>
          </div>
        </div>
        <div class="mt-2">
          <span class="text-muted small">Requieren atención técnica</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Links & Recent Users -->
<div class="row g-4">
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-lightning text-warning me-2"></i>Acciones Rápidas</h5>
      </div>
      <div class="card-body">
        <div class="d-grid gap-2">
          <a href="/admin/usuarios/nuevo" class="btn btn-outline-primary">
            <i class="bi bi-person-plus me-2"></i>Nuevo Usuario
          </a>
          <a href="/admin/aulas/nueva" class="btn btn-outline-success">
            <i class="bi bi-building-add me-2"></i>Nueva Aula
          </a>
          <a href="/estadisticas" class="btn btn-outline-info">
            <i class="bi bi-bar-chart me-2"></i>Ver Estadísticas
          </a>
          <a href="/incidencias" class="btn btn-outline-warning">
            <i class="bi bi-list-check me-2"></i>Gestionar Incidencias
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-people text-uv me-2"></i>Usuarios Recientes</h5>
        <a href="/admin/usuarios" class="btn btn-sm btn-outline-secondary">Ver todos</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <% recentUsers.forEach(u => { %>
              <tr>
                <td class="ps-3 fw-semibold"><%= u.nombre %></td>
                <td class="text-muted small"><%= u.email %></td>
                <td>
                  <% if (u.rol === 'admin') { %>
                    <span class="badge bg-danger">admin</span>
                  <% } else if (u.rol === 'tecnico') { %>
                    <span class="badge bg-warning text-dark">técnico</span>
                  <% } else { %>
                    <span class="badge bg-info text-dark">docente</span>
                  <% } %>
                </td>
                <td>
                  <span class="badge <%= u.activo ? 'bg-success' : 'bg-secondary' %>">
                    <%= u.activo ? 'Activo' : 'Inactivo' %>
                  </span>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/main_bottom') %>
