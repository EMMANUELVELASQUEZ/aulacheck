<%- include('../layouts/main_top') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">
      <i class="bi bi-building<%= aula ? '-gear' : '-add' %> text-uv me-2"></i>
      <%= aula ? 'Editar Aula' : 'Nueva Aula' %>
    </h1>
    <p class="text-muted mb-0">
      <%= aula ? `Modificar datos de ${aula.nombre}` : 'Registrar nueva aula en el sistema' %>
    </p>
  </div>
  <a href="/admin/aulas" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Volver
  </a>
</div>

<div class="row">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold">Información del Aula</h5>
      </div>
      <div class="card-body p-4">
        <form action="<%= action %>?<%= method === 'PUT' ? '_method=PUT' : '' %>" method="POST" novalidate id="aulaForm">
          <div class="row g-3">
            <div class="col-12">
              <label for="nombre" class="form-label fw-semibold">Nombre del Aula <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="nombre" name="nombre"
                value="<%= aula ? aula.nombre : '' %>" required placeholder="Ej: Aula H101">
            </div>
            <div class="col-md-6">
              <label for="edificio" class="form-label fw-semibold">Edificio</label>
              <input type="text" class="form-control" id="edificio" name="edificio"
                value="<%= aula ? (aula.edificio || '') : '' %>" placeholder="Ej: Edificio H">
            </div>
            <div class="col-md-3">
              <label for="piso" class="form-label fw-semibold">Piso</label>
              <input type="text" class="form-control" id="piso" name="piso"
                value="<%= aula ? (aula.piso || '') : '' %>" placeholder="Ej: 2">
            </div>
            <div class="col-md-3">
              <label for="capacidad" class="form-label fw-semibold">Capacidad</label>
              <input type="number" class="form-control" id="capacidad" name="capacidad"
                value="<%= aula ? (aula.capacidad || '') : '' %>" min="1" placeholder="30">
            </div>
            <div class="col-12">
              <label for="descripcion" class="form-label fw-semibold">Descripción</label>
              <textarea class="form-control" id="descripcion" name="descripcion" rows="2"
                placeholder="Descripción breve del aula..."><%= aula ? (aula.descripcion || '') : '' %></textarea>
            </div>
            <% if (aula) { %>
            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="activa" name="activa"
                  <%= aula.activa ? 'checked' : '' %>>
                <label class="form-check-label fw-semibold" for="activa">Aula Activa</label>
              </div>
            </div>
            <% } %>
          </div>

          <% if (!aula) { %>
          <!-- Equipment Section (only on create) -->
          <hr class="my-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-bold mb-0">Equipos del Aula</h6>
            <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddEquipo">
              <i class="bi bi-plus me-1"></i>Agregar Equipo
            </button>
          </div>
          <div id="equiposList">
            <!-- Equipment items added dynamically -->
          </div>
          <% } %>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="/admin/aulas" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-uv px-4">
              <i class="bi bi-save me-2"></i><%= aula ? 'Guardar Cambios' : 'Crear Aula' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <% if (aula && equipos) { %>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-cpu text-uv me-2"></i>Equipos Registrados</h5>
      </div>
      <div class="card-body p-0">
        <% if (equipos.length === 0) { %>
          <div class="text-center py-4 text-muted">
            <i class="bi bi-cpu d-block fs-1 opacity-25 mb-2"></i>
            <p class="small mb-0">Sin equipos registrados</p>
          </div>
        <% } else { %>
        <ul class="list-group list-group-flush">
          <% equipos.forEach(eq => { %>
          <li class="list-group-item d-flex align-items-center justify-content-between py-3 px-4">
            <div>
              <span class="equipo-badge equipo-<%= eq.tipo %> me-2"><%= eq.tipo %></span>
              <span class="fw-semibold small"><%= eq.nombre || eq.tipo %></span>
            </div>
            <span class="badge <%= eq.estado === 'operativo' ? 'bg-success' : eq.estado === 'falla' ? 'bg-danger' : 'bg-warning text-dark' %>">
              <%= eq.estado %>
            </span>
          </li>
          <% }); %>
        </ul>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>
</div>

<% if (!aula) { %>
<script>
let equipoCount = 0;

document.getElementById('btnAddEquipo').addEventListener('click', function() {
  const container = document.getElementById('equiposList');
  const idx = equipoCount++;
  const div = document.createElement('div');
  div.className = 'row g-2 mb-3 equipo-row';
  div.innerHTML = `
    <div class="col-md-4">
      <select class="form-select form-select-sm" name="equipos[${idx}][tipo]" required>
        <option value="">Tipo...</option>
        <option value="camara">Cámara</option>
        <option value="microfono">Micrófono</option>
        <option value="bocinas">Bocinas</option>
        <option value="proyector">Proyector</option>
        <option value="computadora">Computadora</option>
        <option value="internet">Internet</option>
        <option value="videoconferencia">Videoconferencia</option>
      </select>
    </div>
    <div class="col-md-5">
      <input type="text" class="form-control form-control-sm" name="equipos[${idx}][nombre]" placeholder="Nombre del equipo">
    </div>
    <div class="col-md-3">
      <button type="button" class="btn btn-sm btn-outline-danger w-100 remove-equipo">
        <i class="bi bi-trash me-1"></i>Quitar
      </button>
    </div>
  `;
  div.querySelector('.remove-equipo').addEventListener('click', () => div.remove());
  container.appendChild(div);
});
</script>
<% } %>

<%- include('../layouts/main_bottom') %>
