<%- include('../layouts/main_top') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1"><i class="bi bi-clipboard-check text-uv me-2"></i>Diagnóstico de Aula</h1>
    <p class="text-muted mb-0">Verifica el estado del equipo antes de iniciar tu clase</p>
  </div>
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Volver
  </a>
</div>

<!-- Wizard Container -->
<div class="row justify-content-center">
  <div class="col-lg-8">

    <!-- Step Progress -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body py-3">
        <div class="d-flex align-items-center justify-content-between">
          <div class="step-indicator" id="step-ind-1">
            <div class="step-circle active">1</div>
            <span class="step-label">Seleccionar Aula</span>
          </div>
          <div class="step-line"></div>
          <div class="step-indicator" id="step-ind-2">
            <div class="step-circle">2</div>
            <span class="step-label">Checklist</span>
          </div>
          <div class="step-line"></div>
          <div class="step-indicator" id="step-ind-3">
            <div class="step-circle">3</div>
            <span class="step-label">Resultado</span>
          </div>
        </div>
      </div>
    </div>

    <!-- STEP 1: Select Aula -->
    <div id="step-1" class="wizard-step">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-uv text-white py-3">
          <h5 class="mb-0"><i class="bi bi-building me-2"></i>Paso 1: Selecciona el Aula</h5>
        </div>
        <div class="card-body p-4">
          <p class="text-muted mb-4">¿En qué aula estás impartiendo clase hoy?</p>
          <div class="row g-3">
            <% aulas.forEach(aula => { %>
            <div class="col-md-6">
              <div class="aula-card card border-2 cursor-pointer" data-aula-id="<%= aula.id %>" data-aula-nombre="<%= aula.nombre %>">
                <div class="card-body p-3">
                  <div class="d-flex align-items-start gap-3">
                    <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                      <i class="bi bi-building text-primary fs-4"></i>
                    </div>
                    <div>
                      <h6 class="fw-bold mb-0"><%= aula.nombre %></h6>
                      <small class="text-muted"><%= aula.edificio || '' %><% if (aula.piso) { %>, Piso <%= aula.piso %><% } %></small>
                      <% if (aula.capacidad) { %>
                        <div class="mt-1"><small class="text-muted"><i class="bi bi-people me-1"></i><%= aula.capacidad %> lugares</small></div>
                      <% } %>
                    </div>
                    <div class="ms-auto">
                      <i class="bi bi-circle check-icon text-muted fs-4"></i>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
          <div class="d-flex justify-content-end mt-4">
            <button class="btn btn-uv btn-lg px-5" id="btnStep1Next" disabled>
              Continuar <i class="bi bi-arrow-right ms-2"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- STEP 2: Checklist -->
    <div id="step-2" class="wizard-step d-none">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-uv text-white py-3">
          <h5 class="mb-0"><i class="bi bi-check2-square me-2"></i>Paso 2: Verificación de Equipo</h5>
        </div>
        <div class="card-body p-4">
          <p class="text-muted mb-4">Prueba cada equipo y marca si funciona correctamente. Si hay una falla, verás pasos de resolución.</p>
          <div id="checklist-items">
            <!-- Generated by JS -->
          </div>
          <div class="d-flex justify-content-between mt-4">
            <button class="btn btn-outline-secondary btn-lg px-4" id="btnStep2Back">
              <i class="bi bi-arrow-left me-2"></i>Volver
            </button>
            <button class="btn btn-uv btn-lg px-5" id="btnStep2Next">
              Ver Resultado <i class="bi bi-arrow-right ms-2"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- STEP 3: Result -->
    <div id="step-3" class="wizard-step d-none">
      <div class="card border-0 shadow-sm">
        <div class="card-header py-3" id="resultHeader">
          <h5 class="mb-0" id="resultTitle"></h5>
        </div>
        <div class="card-body p-4">
          <div id="resultContent"></div>

          <form action="/diagnostico" method="POST" id="diagnosticoForm">
            <input type="hidden" name="aula_id" id="form-aula-id">
            <input type="hidden" name="checklist" id="form-checklist">
            <input type="hidden" name="resultado" id="form-resultado">
          </form>

          <div class="d-flex justify-content-between mt-4">
            <button class="btn btn-outline-secondary btn-lg px-4" id="btnStep3Back">
              <i class="bi bi-arrow-left me-2"></i>Revisar
            </button>
            <div class="d-flex gap-2">
              <button class="btn btn-success btn-lg px-4" id="btnSaveOk">
                <i class="bi bi-check-circle me-2"></i>Guardar Diagnóstico
              </button>
              <button class="btn btn-danger btn-lg px-4 d-none" id="btnReportFalla">
                <i class="bi bi-exclamation-triangle me-2"></i>Reportar Incidencia
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Troubleshooting Guide (Modal) -->
<div class="modal fade" id="troubleshootModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title fw-bold"><i class="bi bi-tools me-2"></i>Guía de Solución: <span id="troubleshootTitle"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="troubleshootContent"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<style>
.aula-card { cursor: pointer; transition: all 0.2s; }
.aula-card:hover { border-color: #006633 !important; transform: translateY(-2px); }
.aula-card.selected { border-color: #006633 !important; background: #f0fff5; }
.aula-card.selected .check-icon { color: #006633 !important; }
.aula-card.selected .check-icon::before { content: "\F26A"; }
.step-circle { width: 36px; height: 36px; border-radius: 50%; background: #dee2e6; color: #6c757d; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.9rem; margin: 0 auto 4px; transition: all 0.3s; }
.step-circle.active { background: #006633; color: white; }
.step-circle.done { background: #198754; color: white; }
.step-label { font-size: 0.75rem; color: #6c757d; white-space: nowrap; }
.step-indicator { text-align: center; flex: 0; }
.step-line { flex: 1; height: 2px; background: #dee2e6; margin: 0 8px; margin-bottom: 20px; }
.checklist-item { border: 2px solid #dee2e6; border-radius: 12px; padding: 16px; margin-bottom: 12px; transition: all 0.2s; }
.checklist-item.ok { border-color: #198754; background: #f0fff5; }
.checklist-item.falla { border-color: #dc3545; background: #fff5f5; }
.bg-uv { background-color: #006633 !important; }
</style>

<script>
const equiposTroubleshooting = {
  camara: {
    title: 'Cámara Web',
    icon: 'bi-camera-video',
    pasos: [
      'Verifica que el cable USB de la cámara esté bien conectado a la computadora.',
      'Abre el Administrador de Dispositivos y busca la cámara. Si aparece con error, desinstala y vuelve a conectar.',
      'Ve a Configuración > Privacidad > Cámara y asegúrate de que las aplicaciones tengan permiso.',
      'Intenta abrir la cámara con una aplicación diferente (ej. Cámara de Windows o Zoom).',
      'Reinicia la computadora con la cámara conectada.'
    ]
  },
  microfono: {
    title: 'Micrófono',
    icon: 'bi-mic',
    pasos: [
      'Haz clic derecho en el ícono de sonido en la barra de tareas > Abrir configuración de sonido.',
      'En "Entrada", selecciona el micrófono correcto del menú desplegable.',
      'Verifica que el volumen del micrófono esté al menos al 70%.',
      'Revisa que el micrófono no esté en silencio (botón de mute físico o en software).',
      'Ve a Privacidad > Micrófono y activa el permiso para las aplicaciones.',
      'Si es USB, desconecta y vuelve a conectar el cable.'
    ]
  },
  bocinas: {
    title: 'Bocinas / Audio',
    icon: 'bi-speaker',
    pasos: [
      'Verifica que el volumen del sistema no esté en cero o en silencio.',
      'Haz clic derecho en el ícono de sonido > Dispositivos de reproducción.',
      'Asegúrate de que las bocinas correctas sean el dispositivo predeterminado.',
      'Verifica la conexión del cable de audio (jack 3.5mm) o USB.',
      'Intenta reproducir audio desde diferentes aplicaciones para aislar el problema.',
      'Reinicia el servicio de audio de Windows: Servicios > Windows Audio > Reiniciar.'
    ]
  },
  proyector: {
    title: 'Proyector',
    icon: 'bi-projector',
    pasos: [
      'Verifica que el proyector esté encendido (luz de encendido activa).',
      'Presiona el botón de fuente de entrada (Source/Input) en el proyector o control remoto.',
      'Asegúrate de que el cable HDMI o VGA esté firmemente conectado en ambos extremos.',
      'En Windows, presiona Win + P para seleccionar el modo de pantalla (Duplicar/Extender).',
      'Verifica la resolución: Haz clic derecho en el escritorio > Configuración de pantalla.',
      'Deja calentar el proyector 2-3 minutos si acabas de encenderlo.'
    ]
  },
  computadora: {
    title: 'Computadora',
    icon: 'bi-pc-display',
    pasos: [
      'Verifica que la computadora esté encendida y conectada a la energía.',
      'Si no responde, intenta el ciclo de reinicio (mantén presionado el botón de encendido 5 seg).',
      'Verifica que el teclado y ratón estén conectados.',
      'Revisa que no haya actualizaciones de Windows pendientes que requieran reinicio.',
      'Si hay mensaje de error al iniciar, anota el código y repórtalo al área de soporte técnico.'
    ]
  },
  internet: {
    title: 'Conexión a Internet',
    icon: 'bi-wifi',
    pasos: [
      'Verifica que el indicador de WiFi en Windows muestre conexión activa.',
      'Si usas cable ethernet, verifica que esté bien conectado al puerto de red.',
      'Abre el navegador y accede a google.com para verificar conectividad.',
      'Intenta desconectar y reconectar la red WiFi.',
      'Verifica si otros dispositivos en el aula tienen internet (para aislar el problema).',
      'Desde CMD ejecuta: ping 8.8.8.8 para diagnosticar la conexión.'
    ]
  },
  videoconferencia: {
    title: 'Sistema de Videoconferencia',
    icon: 'bi-camera-video',
    pasos: [
      'Verifica que la aplicación de videoconferencia (Zoom/Teams/Meet) esté actualizada.',
      'Cierra y vuelve a abrir la aplicación.',
      'Verifica los permisos de cámara y micrófono en la configuración de la aplicación.',
      'Comprueba la conexión a internet (necesaria para videoconferencia).',
      'Si usas Zoom Room o sistema dedicado, reinicia el controlador táctil.',
      'Verifica que las credenciales de la cuenta no hayan vencido.'
    ]
  }
};

const equiposList = ['camara', 'microfono', 'bocinas', 'proyector', 'computadora', 'internet', 'videoconferencia'];
const equiposLabels = {
  camara: 'Cámara Web',
  microfono: 'Micrófono',
  bocinas: 'Bocinas / Audio',
  proyector: 'Proyector',
  computadora: 'Computadora',
  internet: 'Internet / Red',
  videoconferencia: 'Videoconferencia'
};
const equiposIcons = {
  camara: 'bi-camera-video',
  microfono: 'bi-mic',
  bocinas: 'bi-speaker',
  proyector: 'bi-projector',
  computadora: 'bi-pc-display',
  internet: 'bi-wifi',
  videoconferencia: 'bi-camera-video-fill'
};

let selectedAulaId = null;
let checklistState = {};
const troubleshootModal = new bootstrap.Modal(document.getElementById('troubleshootModal'));

// Step 1: Aula selection
document.querySelectorAll('.aula-card').forEach(card => {
  card.addEventListener('click', function() {
    document.querySelectorAll('.aula-card').forEach(c => c.classList.remove('selected'));
    this.classList.add('selected');
    selectedAulaId = this.dataset.aulaId;
    document.getElementById('btnStep1Next').disabled = false;
  });
});

document.getElementById('btnStep1Next').addEventListener('click', () => goToStep(2));
document.getElementById('btnStep2Back').addEventListener('click', () => goToStep(1));
document.getElementById('btnStep2Next').addEventListener('click', () => goToStep(3));
document.getElementById('btnStep3Back').addEventListener('click', () => goToStep(2));

function goToStep(step) {
  document.querySelectorAll('.wizard-step').forEach(s => s.classList.add('d-none'));
  document.getElementById(`step-${step}`).classList.remove('d-none');
  updateStepIndicators(step);
  if (step === 2) buildChecklist();
  if (step === 3) buildResult();
}

function updateStepIndicators(activeStep) {
  for (let i = 1; i <= 3; i++) {
    const circle = document.querySelector(`#step-ind-${i} .step-circle`);
    circle.classList.remove('active', 'done');
    if (i < activeStep) circle.classList.add('done');
    else if (i === activeStep) circle.classList.add('active');
  }
}

function buildChecklist() {
  const container = document.getElementById('checklist-items');
  container.innerHTML = '';
  equiposList.forEach(tipo => {
    const state = checklistState[tipo] || null;
    const item = document.createElement('div');
    item.className = `checklist-item ${state === 'ok' ? 'ok' : state === 'falla' ? 'falla' : ''}`;
    item.innerHTML = `
      <div class="d-flex align-items-center gap-3">
        <div class="equipo-icon bg-primary bg-opacity-10 text-primary rounded-3 p-2 fs-4">
          <i class="bi ${equiposIcons[tipo]}"></i>
        </div>
        <div class="flex-grow-1">
          <h6 class="mb-0 fw-semibold">${equiposLabels[tipo]}</h6>
          <small class="text-muted">Prueba el equipo y marca su estado</small>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-sm ${state === 'ok' ? 'btn-success' : 'btn-outline-success'} check-btn" data-tipo="${tipo}" data-estado="ok">
            <i class="bi bi-check-lg me-1"></i>OK
          </button>
          <button class="btn btn-sm ${state === 'falla' ? 'btn-danger' : 'btn-outline-danger'} check-btn" data-tipo="${tipo}" data-estado="falla">
            <i class="bi bi-x-lg me-1"></i>Falla
          </button>
          <button class="btn btn-sm btn-outline-warning help-btn" data-tipo="${tipo}" title="Ver guía de solución">
            <i class="bi bi-question-circle"></i>
          </button>
        </div>
      </div>
    `;
    container.appendChild(item);
  });

  // Attach events
  container.querySelectorAll('.check-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const tipo = this.dataset.tipo;
      const estado = this.dataset.estado;
      checklistState[tipo] = estado;
      buildChecklist();
    });
  });

  container.querySelectorAll('.help-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      showTroubleshoot(this.dataset.tipo);
    });
  });
}

function showTroubleshoot(tipo) {
  const guide = equiposTroubleshooting[tipo];
  if (!guide) return;
  document.getElementById('troubleshootTitle').textContent = guide.title;
  const content = document.getElementById('troubleshootContent');
  content.innerHTML = `
    <p class="text-muted mb-3">Sigue estos pasos en orden para diagnosticar y resolver el problema:</p>
    <ol class="list-group list-group-numbered">
      ${guide.pasos.map(paso => `<li class="list-group-item d-flex align-items-start gap-2"><div>${paso}</div></li>`).join('')}
    </ol>
    <div class="alert alert-warning mt-3 mb-0">
      <i class="bi bi-exclamation-triangle me-2"></i>
      Si los pasos anteriores no resuelven el problema, usa el botón "Falla" y reporta la incidencia al área técnica.
    </div>
  `;
  troubleshootModal.show();
}

function buildResult() {
  const failedItems = equiposList.filter(t => checklistState[t] === 'falla');
  const okItems = equiposList.filter(t => checklistState[t] === 'ok');
  const unchecked = equiposList.filter(t => !checklistState[t]);
  const hasFalla = failedItems.length > 0;

  const header = document.getElementById('resultHeader');
  const titleEl = document.getElementById('resultTitle');
  const content = document.getElementById('resultContent');
  const btnOk = document.getElementById('btnSaveOk');
  const btnFalla = document.getElementById('btnReportFalla');

  if (hasFalla) {
    header.className = 'card-header py-3 bg-danger text-white';
    titleEl.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Se detectaron fallas en el equipo';
    btnOk.classList.add('d-none');
    btnFalla.classList.remove('d-none');
  } else {
    header.className = 'card-header py-3 bg-success text-white';
    titleEl.innerHTML = '<i class="bi bi-check-circle me-2"></i>Todo el equipo funciona correctamente';
    btnOk.classList.remove('d-none');
    btnFalla.classList.add('d-none');
  }

  content.innerHTML = `
    <div class="row g-3 mb-4">
      <div class="col-4 text-center">
        <div class="display-4 fw-bold text-success">${okItems.length}</div>
        <div class="text-muted small">Operativos</div>
      </div>
      <div class="col-4 text-center">
        <div class="display-4 fw-bold text-danger">${failedItems.length}</div>
        <div class="text-muted small">Con Falla</div>
      </div>
      <div class="col-4 text-center">
        <div class="display-4 fw-bold text-muted">${unchecked.length}</div>
        <div class="text-muted small">Sin Verificar</div>
      </div>
    </div>
    ${failedItems.length > 0 ? `
    <div class="alert alert-danger">
      <strong><i class="bi bi-exclamation-triangle me-2"></i>Equipos con falla:</strong>
      <ul class="mb-0 mt-2">
        ${failedItems.map(t => `<li>${equiposLabels[t]}</li>`).join('')}
      </ul>
    </div>` : ''}
    ${unchecked.length > 0 ? `
    <div class="alert alert-warning">
      <strong>Equipos sin verificar:</strong> ${unchecked.map(t => equiposLabels[t]).join(', ')}
    </div>` : ''}
  `;

  // Prepare form
  document.getElementById('form-aula-id').value = selectedAulaId;
  document.getElementById('form-checklist').value = JSON.stringify(checklistState);
  document.getElementById('form-resultado').value = hasFalla ? 'falla' : 'ok';
}

document.getElementById('btnSaveOk').addEventListener('click', () => {
  document.getElementById('diagnosticoForm').submit();
});

document.getElementById('btnReportFalla').addEventListener('click', () => {
  document.getElementById('form-resultado').value = 'falla';
  document.getElementById('diagnosticoForm').submit();
});
</script>

<%- include('../layouts/main_bottom') %>
