<%- include('../layouts/main_top') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">
      <% if (isDocente) { %>Mis Incidencias<% } else { %>Todas las Incidencias<% } %>
    </h1>
    <p class="text-muted mb-0">
      <%= pagination.total %> incidencia<%= pagination.total !== 1 ? 's' : '' %> encontrada<%= pagination.total !== 1 ? 's' : '' %>
    </p>
  </div>
  <a href="/incidencias/nueva" class="btn btn-uv">
    <i class="bi bi-plus-circle me-2"></i>Nueva Incidencia
  </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <form action="/incidencias" method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small fw-semibold text-muted mb-1">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="">Todos los estados</option>
          <option value="pendiente" <%= filters.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
          <option value="en_proceso" <%= filters.estado === 'en_proceso' ? 'selected' : '' %>>En Proceso</option>
          <option value="resuelto" <%= filters.estado === 'resuelto' ? 'selected' : '' %>>Resuelto</option>
          <option value="cancelado" <%= filters.estado === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-semibold text-muted mb-1">Prioridad</label>
        <select name="prioridad" class="form-select form-select-sm">
          <option value="">Todas las prioridades</option>
          <option value="critica" <%= filters.prioridad === 'critica' ? 'selected' : '' %>>Crítica</option>
          <option value="alta" <%= filters.prioridad === 'alta' ? 'selected' : '' %>>Alta</option>
          <option value="media" <%= filters.prioridad === 'media' ? 'selected' : '' %>>Media</option>
          <option value="baja" <%= filters.prioridad === 'baja' ? 'selected' : '' %>>Baja</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-semibold text-muted mb-1">Aula</label>
        <select name="aula_id" class="form-select form-select-sm">
          <option value="">Todas las aulas</option>
          <% aulas.forEach(aula => { %>
            <option value="<%= aula.id %>" <%= String(filters.aula_id) === String(aula.id) ? 'selected' : '' %>>
              <%= aula.nombre %>
            </option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-3">
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-uv btn-sm flex-grow-1">
            <i class="bi bi-search me-1"></i>Filtrar
          </button>
          <a href="/incidencias" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-x"></i>
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Incidents Table -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (incidencias.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted opacity-25 d-block mb-3"></i>
        <h5 class="text-muted">No se encontraron incidencias</h5>
        <p class="text-muted small">Ajusta los filtros o crea una nueva incidencia</p>
        <a href="/incidencias/nueva" class="btn btn-uv mt-2">
          <i class="bi bi-plus-circle me-2"></i>Crear Incidencia
        </a>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="width:60px">#</th>
            <th>Aula</th>
            <th>Equipo</th>
            <th>Descripción</th>
            <th>Prioridad</th>
            <th>Estado</th>
            <th>Fecha</th>
            <% if (!isDocente) { %>
            <th>Reportado por</th>
            <% } %>
            <th style="width:80px">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% incidencias.forEach(inc => { %>
          <tr>
            <td class="ps-3">
              <span class="fw-bold text-uv">#<%= inc.id %></span>
            </td>
            <td>
              <div class="fw-semibold small"><%= inc.aula_nombre || 'N/A' %></div>
            </td>
            <td>
              <% if (inc.equipo_tipo) { %>
                <span class="equipo-badge equipo-<%= inc.equipo_tipo %>">
                  <%= inc.equipo_nombre || inc.equipo_tipo %>
                </span>
              <% } else { %>
                <span class="text-muted small">—</span>
              <% } %>
            </td>
            <td style="max-width:200px">
              <span class="text-truncate d-block small" title="<%= inc.descripcion %>">
                <%= inc.descripcion.substring(0, 60) %><% if (inc.descripcion.length > 60) { %>...<% } %>
              </span>
            </td>
            <td>
              <span class="badge prioridad-<%= inc.prioridad %>">
                <% if (inc.prioridad === 'critica') { %><i class="bi bi-fire me-1"></i><% } %>
                <%= inc.prioridad %>
              </span>
            </td>
            <td>
              <span class="badge estado-<%= inc.estado %>">
                <%= inc.estado.replace('_', ' ') %>
              </span>
            </td>
            <td class="text-muted small">
              <%= new Date(inc.fecha_creacion).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'}) %>
            </td>
            <% if (!isDocente) { %>
            <td class="text-muted small"><%= inc.usuario_nombre || '—' %></td>
            <% } %>
            <td>
              <a href="/incidencias/<%= inc.id %>" class="btn btn-sm btn-outline-secondary" title="Ver detalle">
                <i class="bi bi-eye"></i>
              </a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
  <!-- Pagination -->
  <% if (pagination.totalPages > 1) { %>
  <div class="card-footer bg-transparent d-flex align-items-center justify-content-between py-3">
    <span class="text-muted small">
      Mostrando <%= (pagination.page - 1) * pagination.perPage + 1 %> -
      <%= Math.min(pagination.page * pagination.perPage, pagination.total) %>
      de <%= pagination.total %> incidencias
    </span>
    <nav>
      <ul class="pagination pagination-sm mb-0">
        <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.page - 1 %>&estado=<%= filters.estado || '' %>&prioridad=<%= filters.prioridad || '' %>&aula_id=<%= filters.aula_id || '' %>">
            <i class="bi bi-chevron-left"></i>
          </a>
        </li>
        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
        <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= p %>&estado=<%= filters.estado || '' %>&prioridad=<%= filters.prioridad || '' %>&aula_id=<%= filters.aula_id || '' %>">
            <%= p %>
          </a>
        </li>
        <% } %>
        <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.page + 1 %>&estado=<%= filters.estado || '' %>&prioridad=<%= filters.prioridad || '' %>&aula_id=<%= filters.aula_id || '' %>">
            <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <% } %>
</div>

<%- include('../layouts/main_bottom') %>
