<%- include('../layouts/main_top') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1"><i class="bi bi-plus-circle text-uv me-2"></i>Nueva Incidencia</h1>
    <p class="text-muted mb-0">Reporta una falla o problema en el equipo del aula</p>
  </div>
  <a href="/incidencias" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Volver
  </a>
</div>

<% if (typeof fromDiagnostico !== 'undefined' && fromDiagnostico) { %>
<div class="alert alert-info mb-4">
  <i class="bi bi-info-circle-fill me-2"></i>
  <strong>Diagnóstico completado.</strong> Se detectaron fallas. Por favor completa el reporte de incidencia para que el equipo técnico pueda atenderlo.
</div>
<% } %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold">Datos de la Incidencia</h5>
      </div>
      <div class="card-body p-4">
        <form action="/incidencias" method="POST" novalidate id="incidenciaForm">
          <div class="row g-3">
            <!-- Aula -->
            <div class="col-md-6">
              <label for="aula_id" class="form-label fw-semibold">
                Aula <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="aula_id" name="aula_id" required>
                <option value="">Selecciona un aula...</option>
                <% aulas.forEach(aula => { %>
                  <option value="<%= aula.id %>"
                    <%= typeof selectedAula !== 'undefined' && String(selectedAula) === String(aula.id) ? 'selected' : '' %>>
                    <%= aula.nombre %> (<%= aula.edificio || 'Edificio N/A' %>)
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Equipo (dynamic) -->
            <div class="col-md-6">
              <label for="equipo_id" class="form-label fw-semibold">Equipo Afectado</label>
              <select class="form-select" id="equipo_id" name="equipo_id"
                <%= typeof equipos !== 'undefined' && equipos.length === 0 ? 'disabled' : '' %>>
                <option value="">Selecciona primero el aula...</option>
                <% if (typeof equipos !== 'undefined') { %>
                  <% equipos.forEach(eq => { %>
                    <option value="<%= eq.id %>"><%= eq.nombre || eq.tipo %> (<%= eq.tipo %>)</option>
                  <% }); %>
                <% } %>
              </select>
              <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Selecciona el equipo específico con la falla (opcional si es un problema general)
              </div>
            </div>

            <!-- Description -->
            <div class="col-12">
              <label for="descripcion" class="form-label fw-semibold">
                Descripción del Problema <span class="text-danger">*</span>
              </label>
              <textarea class="form-control" id="descripcion" name="descripcion" rows="4"
                placeholder="Describe detalladamente el problema: ¿qué ocurre?, ¿cuándo empezó?, ¿qué intentaste hacer para resolverlo?..."
                required minlength="10"></textarea>
              <div class="form-text">
                <span id="descCount">0</span>/500 caracteres. Sé específico para ayudar al técnico.
              </div>
            </div>

            <!-- Priority -->
            <div class="col-md-6">
              <label for="prioridad" class="form-label fw-semibold">Prioridad</label>
              <select class="form-select" id="prioridad" name="prioridad">
                <option value="baja">Baja — Puede esperar</option>
                <option value="media" selected>Media — Afecta la clase parcialmente</option>
                <option value="alta">Alta — Afecta significativamente la clase</option>
                <option value="critica">Crítica — Impide la clase por completo</option>
              </select>
            </div>

            <!-- Priority Guide -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">Guía de Prioridad</label>
              <div class="priority-guide p-3 rounded-3 bg-light border">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span class="badge prioridad-baja">baja</span>
                  <small>Estético o de comodidad</small>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span class="badge prioridad-media">media</span>
                  <small>Afecta parcialmente la sesión</small>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span class="badge prioridad-alta">alta</span>
                  <small>Dificulta la clase híbrida</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge prioridad-critica">crítica</span>
                  <small>Imposible impartir la clase</small>
                </div>
              </div>
            </div>

            <!-- Submit -->
            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
              <a href="/incidencias" class="btn btn-outline-secondary px-4">Cancelar</a>
              <button type="submit" class="btn btn-uv px-5">
                <i class="bi bi-send me-2"></i>Reportar Incidencia
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
// Dynamic equipment loading
document.getElementById('aula_id').addEventListener('change', async function() {
  const aulaId = this.value;
  const equipoSelect = document.getElementById('equipo_id');

  if (!aulaId) {
    equipoSelect.innerHTML = '<option value="">Selecciona primero el aula...</option>';
    equipoSelect.disabled = true;
    return;
  }

  try {
    const response = await fetch(`/api/equipos/${aulaId}`);
    const equipos = await response.json();

    equipoSelect.innerHTML = '<option value="">— Sin equipo específico —</option>';
    equipos.forEach(eq => {
      const opt = document.createElement('option');
      opt.value = eq.id;
      opt.textContent = `${eq.nombre || eq.tipo} (${eq.tipo})${eq.estado === 'falla' ? ' ⚠️' : ''}`;
      equipoSelect.appendChild(opt);
    });
    equipoSelect.disabled = false;
  } catch (err) {
    console.error('Error cargando equipos:', err);
    equipoSelect.innerHTML = '<option value="">Error al cargar equipos</option>';
  }
});

// Character counter
const descInput = document.getElementById('descripcion');
const descCount = document.getElementById('descCount');
descInput.addEventListener('input', function() {
  descCount.textContent = this.value.length;
  if (this.value.length > 450) descCount.classList.add('text-danger');
  else descCount.classList.remove('text-danger');
});

// Trigger equipment load if aula is pre-selected
const aulaSelect = document.getElementById('aula_id');
if (aulaSelect.value) {
  aulaSelect.dispatchEvent(new Event('change'));
}
</script>

<%- include('../layouts/main_bottom') %>
