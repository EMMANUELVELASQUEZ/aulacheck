<%- include('../layouts/main_top') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1"><i class="bi bi-bar-chart-line text-uv me-2"></i>Estadísticas</h1>
    <p class="text-muted mb-0">Análisis del sistema de incidencias de aulas híbridas</p>
  </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Total Incidencias</p>
            <h2 class="fw-bold mb-0"><%= summary.total %></h2>
          </div>
          <div class="stat-icon bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-list-ul"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Tasa de Resolución</p>
            <h2 class="fw-bold mb-0 text-success"><%= summary.resolutionRate %>%</h2>
          </div>
          <div class="stat-icon bg-success bg-opacity-10 text-success">
            <i class="bi bi-percent"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Tiempo Promedio</p>
            <h2 class="fw-bold mb-0"><%= summary.avgTime %>h</h2>
          </div>
          <div class="stat-icon bg-info bg-opacity-10 text-info">
            <i class="bi bi-clock"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="text-muted small mb-1 fw-semibold text-uppercase">Equipo + Problemático</p>
            <h2 class="fw-bold mb-0 text-truncate" style="font-size:1rem">
              <%= summary.topEquipo ? summary.topEquipo.tipo : 'N/A' %>
            </h2>
            <% if (summary.topEquipo) { %>
              <small class="text-muted"><%= summary.topEquipo.total %> incidencias</small>
            <% } %>
          </div>
          <div class="stat-icon bg-warning bg-opacity-10 text-warning">
            <i class="bi bi-exclamation-triangle"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Charts Row 1 -->
<div class="row g-4 mb-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-bar-chart me-2 text-uv"></i>Incidencias por Tipo de Equipo</h5>
      </div>
      <div class="card-body">
        <canvas id="chartByEquip" style="max-height:300px"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-pie-chart me-2 text-uv"></i>Por Estado</h5>
      </div>
      <div class="card-body d-flex align-items-center justify-content-center">
        <canvas id="chartByStatus" style="max-height:280px; max-width:280px"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Charts Row 2 -->
<div class="row g-4">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-graph-up me-2 text-uv"></i>Incidencias por Mes (últimos 6 meses)</h5>
      </div>
      <div class="card-body">
        <canvas id="chartByMonth" style="max-height:280px"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-building me-2 text-uv"></i>Incidencias por Aula</h5>
      </div>
      <div class="card-body">
        <canvas id="chartByAula" style="max-height:280px"></canvas>
      </div>
    </div>
  </div>
</div>

<script>
const byEquipData = <%- chartData.byEquipType %>;
const byStatusData = <%- chartData.byStatus %>;
const byAulaData = <%- chartData.byAula %>;
const byMonthData = <%- chartData.byMonth %>;

const UV_GREEN = '#006633';
const uvColors = [
  '#006633', '#008844', '#00aa55', '#00cc66', '#33dd88',
  '#f5a623', '#e8940f', '#ffbb44', '#44aacc', '#cc4444'
];

const statusColors = {
  pendiente: '#6c757d',
  en_proceso: '#0d6efd',
  resuelto: '#198754',
  cancelado: '#adb5bd'
};

// Chart: By Equipment Type
if (byEquipData.length > 0) {
  new Chart(document.getElementById('chartByEquip'), {
    type: 'bar',
    data: {
      labels: byEquipData.map(d => d.tipo),
      datasets: [{
        label: 'Incidencias',
        data: byEquipData.map(d => d.total),
        backgroundColor: uvColors,
        borderRadius: 6,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(0,0,0,0.05)' } },
        x: { grid: { display: false } }
      }
    }
  });
} else {
  document.getElementById('chartByEquip').parentElement.innerHTML =
    '<div class="text-center py-5 text-muted"><i class="bi bi-bar-chart display-4 d-block opacity-25 mb-2"></i><p>Sin datos aún</p></div>';
}

// Chart: By Status
if (byStatusData.length > 0) {
  new Chart(document.getElementById('chartByStatus'), {
    type: 'doughnut',
    data: {
      labels: byStatusData.map(d => d.estado.replace('_', ' ')),
      datasets: [{
        data: byStatusData.map(d => d.total),
        backgroundColor: byStatusData.map(d => statusColors[d.estado] || '#6c757d'),
        borderWidth: 3,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true } }
      },
      cutout: '60%'
    }
  });
} else {
  document.getElementById('chartByStatus').parentElement.innerHTML =
    '<div class="text-center py-5 text-muted"><i class="bi bi-pie-chart display-4 d-block opacity-25 mb-2"></i><p>Sin datos aún</p></div>';
}

// Chart: By Month
if (byMonthData.length > 0) {
  new Chart(document.getElementById('chartByMonth'), {
    type: 'line',
    data: {
      labels: byMonthData.map(d => d.mes_label),
      datasets: [{
        label: 'Incidencias',
        data: byMonthData.map(d => d.total),
        borderColor: UV_GREEN,
        backgroundColor: 'rgba(0,102,51,0.08)',
        pointBackgroundColor: UV_GREEN,
        pointRadius: 5,
        tension: 0.3,
        fill: true
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(0,0,0,0.05)' } },
        x: { grid: { display: false } }
      }
    }
  });
} else {
  document.getElementById('chartByMonth').parentElement.innerHTML =
    '<div class="text-center py-5 text-muted"><i class="bi bi-graph-up display-4 d-block opacity-25 mb-2"></i><p>Sin datos aún</p></div>';
}

// Chart: By Aula
if (byAulaData.length > 0) {
  new Chart(document.getElementById('chartByAula'), {
    type: 'bar',
    data: {
      labels: byAulaData.map(d => d.nombre),
      datasets: [{
        label: 'Incidencias',
        data: byAulaData.map(d => d.total),
        backgroundColor: 'rgba(0,102,51,0.7)',
        borderColor: UV_GREEN,
        borderWidth: 1,
        borderRadius: 6,
        borderSkipped: false
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        x: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(0,0,0,0.05)' } },
        y: { grid: { display: false } }
      }
    }
  });
} else {
  document.getElementById('chartByAula').parentElement.innerHTML =
    '<div class="text-center py-5 text-muted"><i class="bi bi-building display-4 d-block opacity-25 mb-2"></i><p>Sin datos aún</p></div>';
}
</script>

<%- include('../layouts/main_bottom') %>
