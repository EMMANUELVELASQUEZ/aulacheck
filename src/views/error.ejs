<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error del servidor | AulaCheck</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(135deg, #991b1b 0%, #6b2020 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
  </style>
</head>
<body>
  <div class="text-center text-white">
    <div class="fw-bold mb-2" style="font-size:8rem;opacity:0.3">500</div>
    <h2 class="fw-bold mb-3">Error del Servidor</h2>
    <p class="text-white-50 mb-2">Ocurrió un error inesperado. Por favor intenta de nuevo.</p>
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-danger d-inline-block mb-4"><code><%= message %></code></div>
    <% } %>
    <div class="d-flex gap-3 justify-content-center mt-4">
      <a href="/dashboard" class="btn btn-warning btn-lg px-5 fw-bold">
        <i class="bi bi-house me-2"></i>Ir al Dashboard
      </a>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
